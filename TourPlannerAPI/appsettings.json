{
  "Logging": {
    "LogDirectory": "Logs",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OpenRouteService": {
    "ApiKey": "",
    "BaseUrl": "https://api.openrouteservice.org"
  },
  "ImageStorage": {
    "BaseDirectory": "ImageStore",
    "MaxSizeBytes": 5242880
  },
  "Jwt": {
    "Key": "",
